%{
/*
 * lexer.l — Flex Lexical Analyzer for MiniC Compiler
 * Member 1: Lexical + Syntax Analysis
 *
 * Tokens recognized:
 *   - Keywords: int, float, char, bool, void, if, else, while, for,
 *               return, struct, true, false, break, continue
 *   - Identifiers, integer literals, float literals, char literals, string literals
 *   - All C operators (arithmetic, relational, logical, assignment, bitwise)
 *   - Punctuation / delimiters
 *   - Single-line (//) and multi-line (/* *\/) comments (skipped)
 *   - Preprocessor directives (#include, #define) — skipped for simplicity
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "ast.h"
#include "parser.tab.h"   /* token defines generated by Bison */

/* ── globals ────────────────────────────────────────────────────────────── */
int line_num   = 1;   /* current source line (1-based)   */
int col_num    = 1;   /* current column  (1-based)        */
int prev_col   = 1;   /* column before last token         */

/* ── helpers ─────────────────────────────────────────────────────────────── */
#define UPDATE_COL()  do { prev_col = col_num; col_num += yyleng; } while(0)
#define RESET_COL()   do { prev_col = 1; col_num = 1; } while(0)

static void lex_error(const char *msg) {
    fprintf(stderr, "[Lexer Error] Line %d, Col %d: %s: '%s'\n",
            line_num, col_num, msg, yytext);
}

%}

/* ── Flex options ─────────────────────────────────────────────────────────── */
%option noyywrap
%option yylineno

/* ── Named patterns ──────────────────────────────────────────────────────── */
DIGIT        [0-9]
LETTER       [a-zA-Z_]
ALPHANUM     [a-zA-Z0-9_]
INTLIT       {DIGIT}+
FLOATLIT     {DIGIT}+\.{DIGIT}+([eE][+-]?{DIGIT}+)?
HEXLIT       0[xX][0-9a-fA-F]+
OCTLIT       0[0-7]+
CHARLIT      '([^'\\]|\\.)'
STRLIT       \"([^\"\\]|\\.)*\"
IDENT        {LETTER}{ALPHANUM}*
WHITESPACE   [ \t\r]+

%%

 /* ── Comments ─────────────────────────────────────────────────────────── */
"//"[^\n]*           { UPDATE_COL(); /* single-line comment: skip */ }
"/*"                 {
                       UPDATE_COL();
                       int c, prev = 0;
                       while ((c = input()) != EOF) {
                           if (c == '\n') { line_num++; RESET_COL(); }
                           else col_num++;
                           if (prev == '*' && c == '/') break;
                           prev = c;
                       }
                     }

 /* ── Preprocessor (skip whole line) ─────────────────────────────────── */
^[ \t]*"#"[^\n]*     { UPDATE_COL(); }

 /* ── Keywords ────────────────────────────────────────────────────────── */
"int"        { UPDATE_COL(); return KW_INT;      }
"float"      { UPDATE_COL(); return KW_FLOAT;    }
"char"       { UPDATE_COL(); return KW_CHAR;     }
"bool"       { UPDATE_COL(); return KW_BOOL;     }
"void"       { UPDATE_COL(); return KW_VOID;     }
"if"         { UPDATE_COL(); return KW_IF;       }
"else"       { UPDATE_COL(); return KW_ELSE;     }
"while"      { UPDATE_COL(); return KW_WHILE;    }
"do"         { UPDATE_COL(); return KW_DO;       }
"for"        { UPDATE_COL(); return KW_FOR;      }
"return"     { UPDATE_COL(); return KW_RETURN;   }
"struct"     { UPDATE_COL(); return KW_STRUCT;   }
"break"      { UPDATE_COL(); return KW_BREAK;    }
"continue"   { UPDATE_COL(); return KW_CONTINUE; }
"true"       { UPDATE_COL(); yylval.ival = 1; return BOOL_LITERAL;  }
"false"      { UPDATE_COL(); yylval.ival = 0; return BOOL_LITERAL;  }
"printf"     { UPDATE_COL(); yylval.sval = strdup(yytext); return KW_PRINTF;  }
"scanf"      { UPDATE_COL(); yylval.sval = strdup(yytext); return KW_SCANF;   }

 /* ── Identifiers ─────────────────────────────────────────────────────── */
{IDENT}      { UPDATE_COL(); yylval.sval = strdup(yytext); return IDENTIFIER; }

 /* ── Numeric literals ────────────────────────────────────────────────── */
{FLOATLIT}   { UPDATE_COL(); yylval.fval = atof(yytext);  return FLOAT_LITERAL;   }
{HEXLIT}     { UPDATE_COL(); yylval.ival = (int)strtol(yytext, NULL, 16); return INT_LITERAL; }
{OCTLIT}     { UPDATE_COL(); yylval.ival = (int)strtol(yytext, NULL, 8);  return INT_LITERAL; }
{INTLIT}     { UPDATE_COL(); yylval.ival = atoi(yytext);  return INT_LITERAL;     }

 /* ── Character & string literals ─────────────────────────────────────── */
{CHARLIT}    { UPDATE_COL(); yylval.cval = yytext[1]; return CHAR_LITERAL;   }
{STRLIT}     { UPDATE_COL(); yylval.sval = strdup(yytext); return STR_LITERAL; }

 /* ── Assignment operators ─────────────────────────────────────────────── */
"+="         { UPDATE_COL(); return OP_PLUS_ASSIGN;  }
"-="         { UPDATE_COL(); return OP_MINUS_ASSIGN; }
"*="         { UPDATE_COL(); return OP_MUL_ASSIGN;   }
"/="         { UPDATE_COL(); return OP_DIV_ASSIGN;   }
"%="         { UPDATE_COL(); return OP_MOD_ASSIGN;   }
"&="         { UPDATE_COL(); return OP_AND_ASSIGN;   }
"|="         { UPDATE_COL(); return OP_OR_ASSIGN;    }
"^="         { UPDATE_COL(); return OP_XOR_ASSIGN;   }
"<<="        { UPDATE_COL(); return OP_LSHIFT_ASSIGN;}
">>="        { UPDATE_COL(); return OP_RSHIFT_ASSIGN;}

 /* ── Increment / Decrement ───────────────────────────────────────────── */
"++"         { UPDATE_COL(); return OP_INC; }
"--"         { UPDATE_COL(); return OP_DEC; }

 /* ── Relational & equality ───────────────────────────────────────────── */
"=="         { UPDATE_COL(); return OP_EQ;  }
"!="         { UPDATE_COL(); return OP_NEQ; }
"<="         { UPDATE_COL(); return OP_LEQ; }
">="         { UPDATE_COL(); return OP_GEQ; }
"<"          { UPDATE_COL(); return OP_LT;  }
">"          { UPDATE_COL(); return OP_GT;  }

 /* ── Logical ─────────────────────────────────────────────────────────── */
"&&"         { UPDATE_COL(); return OP_AND; }
"||"         { UPDATE_COL(); return OP_OR;  }
"!"          { UPDATE_COL(); return OP_NOT; }

 /* ── Bitwise ─────────────────────────────────────────────────────────── */
"<<"         { UPDATE_COL(); return OP_LSHIFT; }
">>"         { UPDATE_COL(); return OP_RSHIFT; }
"&"          { UPDATE_COL(); return OP_BITAND; }
"|"          { UPDATE_COL(); return OP_BITOR;  }
"^"          { UPDATE_COL(); return OP_BITXOR; }
"~"          { UPDATE_COL(); return OP_BITNOT; }

 /* ── Arithmetic ──────────────────────────────────────────────────────── */
"+"          { UPDATE_COL(); return OP_PLUS;  }
"-"          { UPDATE_COL(); return OP_MINUS; }
"*"          { UPDATE_COL(); return OP_MUL;   }
"/"          { UPDATE_COL(); return OP_DIV;   }
"%"          { UPDATE_COL(); return OP_MOD;   }

 /* ── Arrow / dot (struct member access) ─────────────────────────────── */
"->"         { UPDATE_COL(); return OP_ARROW; }
"."          { UPDATE_COL(); return OP_DOT;   }

 /* ── Assignment ──────────────────────────────────────────────────────── */
"="          { UPDATE_COL(); return OP_ASSIGN; }

 /* ── Punctuation ─────────────────────────────────────────────────────── */
"("          { UPDATE_COL(); return LPAREN;    }
")"          { UPDATE_COL(); return RPAREN;    }
"{"          { UPDATE_COL(); return LBRACE;    }
"}"          { UPDATE_COL(); return RBRACE;    }
"["          { UPDATE_COL(); return LBRACKET;  }
"]"          { UPDATE_COL(); return RBRACKET;  }
";"          { UPDATE_COL(); return SEMICOLON; }
","          { UPDATE_COL(); return COMMA;     }
":"          { UPDATE_COL(); return COLON;     }
"?"          { UPDATE_COL(); return QUESTION;  }

 /* ── Whitespace & newlines ───────────────────────────────────────────── */
{WHITESPACE} { UPDATE_COL(); /* skip */ }
"\n"         { line_num++; RESET_COL(); }

 /* ── Unknown / error ─────────────────────────────────────────────────── */
.            { UPDATE_COL(); lex_error("Unknown character"); }

%%
